# Contoh sahaja: portal tidak memuatkan .env secara automatik.
# Tetapkan nilai sebenar di Vercel Environment Variables; jangan commit .env.
# URL PostgreSQL awam Railway untuk database bot LeeA yang sama (bukan railway.internal).
DATABASE_URL=
# Wajib: kata laluan portal yang kuat; tiada kata laluan lalai.
PORTAL_PASSWORD=
SECRET_KEY=
# Identiti deployment (username mesti sepadan dengan clients.username dalam DB).
CLIENT_USERNAME=architechsystems
CLIENT_NAME=Architech Systems
CLIENT_CODE=CLI-1001
# URL HTTPS logo yang dipercayai, atau biarkan kosong untuk logo statik.
CLIENT_LOGO_URL=
# Rahsia sama seperti CHAT_SOCKET_SECRET bot Railway, sekurang-kurangnya 32 aksara.
CHAT_SOCKET_SECRET=
CHAT_SOCKET_URL=wss://<domain-awam-bot-railway>/ws/chat